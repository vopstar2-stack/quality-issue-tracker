# Vercel 프로젝트에 Postgres를 연결하면 자동으로 채워줍니다. 로컬에서는
# `vercel env pull .env.local`로 받아오는 게 가장 쉽습니다.
POSTGRES_URL=

# 카카오 개발자 콘솔(https://developers.kakao.com)의 "앱 키" 메뉴에서 발급받은 값들을 입력하세요.
# 자세한 설정 절차는 README.md의 "카카오톡 발송 기능 설정" 섹션을 참고하세요.

# 앱 키 > JavaScript 키 (브라우저에 노출되는 공개 키)
NEXT_PUBLIC_KAKAO_JS_KEY=

# 앱 키 > REST API 키 (서버에서만 사용, 노출되면 안 됨)
KAKAO_REST_API_KEY=

# 카카오 로그인 > 보안 > Client Secret을 켠 경우에만 입력 (기본값은 꺼져 있어 대부분 비워둬도 됨)
KAKAO_CLIENT_SECRET=

# 이슈 삭제 시 입력해야 하는 확인 코드. 서버에서만 비교하며 브라우저로는 절대 전달되지 않음.
DELETE_CONFIRM_CODE=
